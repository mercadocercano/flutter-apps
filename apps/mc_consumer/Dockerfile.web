FROM nginxinc/nginx-unprivileged:alpine

COPY build/web /usr/share/nginx/html

# Listen on 3000 (consumer web)
RUN printf 'server {\n\
  listen 3000;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location = /index.html { add_header Cache-Control "no-cache, no-store, must-revalidate"; }\n\
  location = /flutter_service_worker.js { add_header Cache-Control "no-cache, no-store, must-revalidate"; }\n\
  location = /flutter_bootstrap.js { add_header Cache-Control "no-cache, no-store, must-revalidate"; }\n\
  location = /main.dart.js { add_header Cache-Control "no-cache, no-store, must-revalidate"; }\n\
  location = /version.json { add_header Cache-Control "no-cache, no-store, must-revalidate"; }\n\
  location = /manifest.json { add_header Cache-Control "no-cache, no-store, must-revalidate"; }\n\
  location ~* ^/(assets|canvaskit|icons)/ { add_header Cache-Control "public, max-age=31536000, immutable"; }\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000
