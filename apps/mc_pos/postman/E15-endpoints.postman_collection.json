    {
      "name": "Tenant Config",
      "item": [
        {
          "name": "tenantConfig(key) [ruta declarada en front — ROTA, ver api-audit-E15.md]",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/tenant-service/api/v1/tenant/config/{{config_key}}", "host": ["{{base_url}}"], "path": ["tenant-service", "api", "v1", "tenant", "config", "{{config_key}}"] }
          }
        },
        {
          "name": "tenantConfig(key) [ruta real de Kong]",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/tenant/api/v1/tenant/config/{{config_key}}", "host": ["{{base_url}}"], "path": ["tenant", "api", "v1", "tenant", "config", "{{config_key}}"] }
          }
        },
        {
          "name": "tenantConfigBase (POST) [ruta declarada en front — ROTA]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"key\":\"test.key\",\"value\":\"x\"}" },
            "url": { "raw": "{{base_url}}/tenant-service/api/v1/tenant/config", "host": ["{{base_url}}"], "path": ["tenant-service", "api", "v1", "tenant", "config"] }
          }
        },
