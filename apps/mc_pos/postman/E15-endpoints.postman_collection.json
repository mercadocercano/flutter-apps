{
  "info": {
    "name": "MC-E15 — mc_pos endpoints (Kong sweep)",
    "description": "Un request por cada endpoint declarado en api_endpoints.dart (mc_infrastructure). Usa {{jwt}} y {{tenant_id}} — nunca tokens hardcodeados. Corrida contra localhost:8000 (Kong). Ver active/mercado-cercano/docs/api-audit-E15.md para resultados documentados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "jwt", "value": "" },
    { "key": "tenant_id", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "brand_id", "value": "" },
    { "key": "sale_id", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "config_key", "value": "catalog.stock_policy" }
  ],
  "item": [
    {
      "name": "IAM",
      "item": [
        {
          "name": "authLogin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@democompany.com\",\"password\":\"123456\",\"provider\":\"LOCAL\"}" },
            "url": { "raw": "{{base_url}}/iam/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["iam", "api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "authRefresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refresh_token\":\"{{refresh_token}}\"}" },
            "url": { "raw": "{{base_url}}/iam/api/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["iam", "api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "authLogout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{base_url}}/iam/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["iam", "api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "onboardingRegister",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/onboarding/api/v1/register-user", "host": ["{{base_url}}"], "path": ["onboarding", "api", "v1", "register-user"] }
          }
        }
      ]
    },
    {
      "name": "PIM - Categorias",
      "item": [
        {
          "name": "categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/pim/api/v1/categories", "host": ["{{base_url}}"], "path": ["pim", "api", "v1", "categories"] }
          }
        },
        {
          "name": "category(id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/pim/api/v1/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["pim", "api", "v1", "categories", "{{category_id}}"] }
          }
        }
      ]
    },
    {
      "name": "PIM - Marcas",
      "item": [
        {
          "name": "brands",
