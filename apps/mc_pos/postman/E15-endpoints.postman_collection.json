    {
      "name": "Stock",
      "item": [
        {
          "name": "stockEntries (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"variant_sku\":\"ALMACEN-EE401E1F\",\"product_name\":\"Test\",\"entry_type\":\"initial_stock\",\"quantity\":10,\"unit_of_measure\":\"unit\",\"notes\":\"audit-E15\"}" },
            "url": { "raw": "{{base_url}}/stock/api/v1/stock-entries", "host": ["{{base_url}}"], "path": ["stock", "api", "v1", "stock-entries"] }
          }
        },
        {
          "name": "stockAvailability",
          "request": {
            "method": "GET",
