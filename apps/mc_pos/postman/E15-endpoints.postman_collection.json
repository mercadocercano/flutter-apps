          }
        },
        {
          "name": "productsByCriteria",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/pim/api/v1/products/criteria", "host": ["{{base_url}}"], "path": ["pim", "api", "v1", "products", "criteria"] }
          }
        }
      ]
    },
    {
      "name": "Sales - POS",
      "item": [
        {
          "name": "posSales",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/sales/api/v1/sales/pos", "host": ["{{base_url}}"], "path": ["sales", "api", "v1", "sales", "pos"] }
          }
        },
        {
          "name": "posSale(id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenant_id}}" }],
            "url": { "raw": "{{base_url}}/sales/api/v1/sales/pos/{{sale_id}}", "host": ["{{base_url}}"], "path": ["sales", "api", "v1", "sales", "pos", "{{sale_id}}"] }
          }
        },
        {
          "name": "posSalePdf(id)",
          "request": {
