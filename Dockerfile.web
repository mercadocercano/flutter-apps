# Build de apps Flutter Web en Linux — evita el límite de macOS 13 del host
# (Flutter 3.44.x requiere macOS 14+ para correr nativo; en Docker/Linux no aplica).
# Context de build: raíz del monorepo flutter-apps (Dart workspace + melos).
#
# Targets nginx: consumer | pos | admin  (elegir con `target:` en compose)

# ---------------------------------------------------------------------------
# Stage base: SDK Flutter + resolución del workspace completo
# ---------------------------------------------------------------------------
FROM ghcr.io/cirruslabs/flutter:stable AS base
WORKDIR /src
# Flutter se queja si el repo pertenece a otro owner
RUN git config --global --add safe.directory '*'
# Copiar todo el monorepo (el workspace Dart exige todos sus miembros presentes)
COPY . .
# Resolver dependencias de todo el workspace de una vez
RUN flutter pub get

# ---------------------------------------------------------------------------
# Stages de build por app (web release)
# ---------------------------------------------------------------------------
# URL del gateway Kong vista desde el navegador del host. Override por app con
# --build-arg API_BASE_URL=... / KONG_BASE_URL=... en compose si hace falta.
# mc_pos/mc_consumer leen API_BASE_URL; mc_admin lee KONG_BASE_URL.
FROM base AS build-consumer
ARG API_BASE_URL=http://localhost:8000
RUN cd apps/mc_consumer && flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL

FROM base AS build-pos
ARG API_BASE_URL=http://localhost:8000
RUN cd apps/mc_pos && flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL

FROM base AS build-admin
ARG KONG_BASE_URL=http://localhost:8000
ARG MARKETPLACE_ADMIN_API_KEY=
RUN cd apps/mc_admin && flutter build web --release --pwa-strategy=none --dart-define=KONG_BASE_URL=$KONG_BASE_URL --dart-define=MARKETPLACE_ADMIN_API_KEY=$MARKETPLACE_ADMIN_API_KEY

# ---------------------------------------------------------------------------
# Stages nginx (sirven el build estático). Todos en :3000 interno.
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:alpine AS consumer
COPY --from=build-consumer /src/apps/mc_consumer/build/web /usr/share/nginx/html
COPY nginx-flutter.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000

FROM nginxinc/nginx-unprivileged:alpine AS pos
COPY --from=build-pos /src/apps/mc_pos/build/web /usr/share/nginx/html
COPY nginx-flutter.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000

FROM nginxinc/nginx-unprivileged:alpine AS admin
COPY --from=build-admin /src/apps/mc_admin/build/web /usr/share/nginx/html
COPY nginx-flutter.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
